NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=db-catalogo
# Solo para desarrollo local. En producción debe permanecer en false.
DB_SYNCHRONIZE=true
JWT_SECRET=solo-desarrollo-genera-uno-con-openssl-rand-hex-32
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# AWS S3 (the IAM identity only needs s3:PutObject for this bucket/prefix)
S3_BUCKET=nombre-del-bucket
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: CDN/custom public base URL, without trailing slash.
# If omitted, the standard public AWS S3 URL is returned.
S3_PUBLIC_URL=https://cdn.example.com

# Optional: S3-compatible providers such as MinIO or Cloudflare R2.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
